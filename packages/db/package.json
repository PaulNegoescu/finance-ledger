{
  "name": "@ledger/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./queries": "./src/queries.ts",
    "./rule-management": "./src/rule-management.ts",
    "./overview": "./src/overview.ts",
    "./import-history": "./src/import-history.ts",
    "./bulk-categories": "./src/bulk-categories.ts"
  },
  "scripts": {
